NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://resume_match_app:replace-with-database-password@localhost:5432/resume_match_db
CORS_ORIGIN=http://localhost:5173
BODY_LIMIT=1mb
SESSION_TTL_DAYS=7
TRUST_PROXY=false
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=60000
ANALYSIS_WORKER_POLL_MS=2000
ANALYSIS_WORKER_LEASE_MS=90000
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_MAX_ACTIVE_PER_USER=2
INTERVIEW_PREPARATION_MAX_ACTIVE_PER_USER=2
